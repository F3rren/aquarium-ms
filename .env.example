# Copy this file to .env and adjust values for your local environment.
# The .env file is gitignored — never committed.

# ─── Spring Boot profile ─────────────────────────────────────────────────────
# Leave empty for local dev, use "staging" for staging, "prod" for production.
SPRING_PROFILES_ACTIVE=

# ─── Database credentials ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=root

# ─── Grafana credentials ─────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
