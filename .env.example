# Copy this file to .env and adjust values for your local environment.
# The .env file is gitignored — never committed.

# ─── Spring Boot profile ─────────────────────────────────────────────────────
# Leave empty for local dev, use "staging" for staging, "prod" for production.
SPRING_PROFILES_ACTIVE=

# ─── Database credentials ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=root

# ─── Grafana credentials ─────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ─── API Gateway rate limiting ───────────────────────────────────────────────
# Set to false to disable rate limiting entirely on the gateway - useful when
# security-testing every other module (SQLi, missing auth, brute force) and
# the rate limiter's own throttling would otherwise mask real findings behind
# 429s before the scan finishes. Leave true/unset for anything meant to
# behave like production, including a dedicated rate-limiting test run.
RATE_LIMIT_ENABLED=true
