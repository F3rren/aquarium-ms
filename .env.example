# Staging environment template for EC2.
# Rename this file to .env before running docker compose.

# Active Spring profile — use "staging" on EC2, leave empty for local dev
SPRING_PROFILES_ACTIVE=staging

# Database credentials
DB_USER=postgres
DB_PASSWORD=change_me

# Grafana credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me
