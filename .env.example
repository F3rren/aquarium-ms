# Copy this file to .env and fill in your own values.
# The .env file is gitignored — never commit it.

# ─── Database credentials ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=changeme

# ─── Grafana credentials ─────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# ─── Kafka UI credentials ────────────────────────────────────────────────────
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=changeme

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to true only for local development — never in production
SWAGGER_ENABLED=false

# ─── Gateway JWT auth ─────────────────────────────────────────────────────────
# Signs/validates every JWT the gateway issues. Any length works (it's SHA-256-hashed into a
# valid HS256 key regardless), but treat it exactly like a database password: never a real
# secret here, only ever set via a real .env you don't commit.
JWT_SECRET=changeme

# Two fixed test identities for POST /auth/login (see api-gateway's AuthController) - not a
# real user system, just enough to give Sentinel's IDOR module two distinct identities to
# compare. Usernames default to userA/userB; only the passwords need to be set.
AUTH_USER_A_PASSWORD=changeme
AUTH_USER_B_PASSWORD=changeme

# ─── Homepage dashboard ──────────────────────────────────────────────────────
# Host header(s) the homepage dashboard accepts (comma-separated). Must match how you
# open it in the browser. Default fits the published port (3001); change it if you reach
# it via a LAN IP or hostname, e.g. HOMEPAGE_ALLOWED_HOSTS=localhost:3001,192.168.1.10:3001
HOMEPAGE_ALLOWED_HOSTS=localhost:3001
